<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jakerobb.host-deploy</string>
  <!-- A system daemon that drops to the normal user (UserName): it starts at boot with no GUI session (a FileVault-locked
       Mac sits at the login window after an unlock), and it never has root, so it can only alert about root-owned
       installs, not make them. The deploy clone lives in this user's home, which is why the user and paths are fixed. -->
  <key>UserName</key>
  <string>jakerobb</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/jakerobb/.local/share/host-deploy/homelab/scripts/host-deploy/host-deploy.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/jakerobb/.local/state/host-deploy/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jakerobb/.local/state/host-deploy/launchd.log</string>
</dict>
</plist>
