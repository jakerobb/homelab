<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only needed for the manual (non-Homebrew) install path in
  ../../docs/mac-host-metrics.md -- `brew services` provides its own
  LaunchAgent when Homebrew works, but the tar.gz release doesn't include
  a launchd service definition at all, so this stands in for it.

  A LaunchDaemon (not a LaunchAgent) so it starts at boot before anyone
  logs in -- this Mac runs headless most of the time.

  Deliberately runs as root (no UserName key). macOS Sequoia's Local
  Network privacy blocks non-root third-party processes launched by
  launchd from reaching LAN addresses, and the kernel reports the denial
  as EHOSTUNREACH ("no route to host") with no prompt and no log line --
  found live: Telegraf as a non-root LaunchDaemon could never reach
  otel.jakerobb.org (a LAN IP) while nc/curl from iTerm worked fine. Root
  processes are exempt. Everything Telegraf executes lives in a
  root-owned directory, so running as root doesn't open up script
  tampering.

  @@TELEGRAF_PREFIX@@ is substituted at copy time (see the doc's setup
  steps) -- not valid as-is.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jakerobb.telegraf</string>
    <key>ProgramArguments</key>
    <array>
        <string>@@TELEGRAF_PREFIX@@/bin/telegraf</string>
        <string>--config</string>
        <string>@@TELEGRAF_PREFIX@@/etc/telegraf.conf</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@@TELEGRAF_PREFIX@@/var/log/telegraf-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>@@TELEGRAF_PREFIX@@/var/log/telegraf-launchd.log</string>
</dict>
</plist>
