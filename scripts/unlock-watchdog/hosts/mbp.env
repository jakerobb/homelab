# Settings for the 2018 MacBook Pro, read by unlock-watchdog.sh (and by the systemd unit). Plain VAR=value lines.
LABEL="MacBook Pro"
HOST=192.168.102.9
WORKER_NAME=talos-worker-mbp
WORKER_HOST=192.168.102.34
SECRETS_FILE=/home/jakerobb/bin/secrets/mbp-unlock.sops.yaml
# This Mac has no network at the FileVault screen (no ARP, no pre-boot SSH), so the watchdog can't unlock it: it only
# alerts that it needs unlocking by hand. Remove this line to try the automatic unlock if pre-boot SSH ever works.
UNLOCK_MODE=alert
