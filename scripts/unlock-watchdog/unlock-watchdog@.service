[Unit]
Description=Unlock %i's FileVault over SSH when its Talos worker is down
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as the normal user because that is who holds the age key that decrypts the secret (scripts/secrets/).
User=jakerobb
Environment=HOME=/home/jakerobb
Environment=SOPS_AGE_KEY_FILE=/home/jakerobb/.config/sops/age/keys.txt
ExecStart=/usr/local/lib/unlock-watchdog/unlock-watchdog.sh %i
StateDirectory=unlock-watchdog/%i
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
