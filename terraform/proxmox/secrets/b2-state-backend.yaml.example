# B2 application key for the Terraform state bucket (jakerobb-homelab-tfstate),
# read by the S3 backend in backend.tf. Scope the key to that one bucket.
# Copy to b2-state-backend.sops.yaml, fill in, then encrypt in place:
#   sops -e -i terraform/proxmox/secrets/b2-state-backend.sops.yaml
AWS_ACCESS_KEY_ID: "<B2 keyID>"
AWS_SECRET_ACCESS_KEY: "<B2 applicationKey>"
